# Copy this file to .env and fill in real values. Never commit .env.

SECRET_KEY=change-me-generate-with-get_random_secret_key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_URL=postgresql://ems_dev:changeme@127.0.0.1:5432/ems_dev

CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False

# Optional — leave blank to use in-process local-memory cache (see
# config/settings/base.py). Only needed once Celery/Redis-backed sessions
# are introduced in a later phase.
REDIS_URL=

DEFAULT_FROM_EMAIL=ems@example.local
